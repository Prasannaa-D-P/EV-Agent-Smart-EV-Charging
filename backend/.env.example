# EV-Agent OSINT Layer Environment Configuration

# Operational Mode: 'mock' (offline demo data) or 'live' (public external APIs)
OSINT_MODE=mock

# Primary APIs
OPENCHARGEMAP_API_KEY=
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Secondary / Prepared APIs
BEE_API_BASE_URL=
TNEV_API_BASE_URL=
DATAGOV_API_KEY=
DATAGOV_DATASET_ID=

# Cache & Rate Limiting
CACHE_TTL_SECONDS=3600
NOMINATIM_RATE_LIMIT_DELAY=1.0
OVERPASS_RATE_LIMIT_DELAY=2.0

# Server
PORT=5000
DEBUG=True
